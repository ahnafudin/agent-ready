# Generic rules only; `npm run stack:apply` adds framework artefacts in the managed block below.
# Ambiguous names (`bin/`, `obj/`, `out/`, `target/`) are left out: ignoring real source loses files silently.

# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
*.p12

# ── OS / editor junk ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Universal build / dependency output ───────────────────────────────────
node_modules/
dist/
coverage/
.cache/
*.log

# ── Python (unambiguous everywhere) ───────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# ── Vendored dependencies (root-scoped: PHP, Go, Ruby) ────────────────────
/vendor/
/.bundle/

# ── Toolchain caches ──────────────────────────────────────────────────────
.gradle/
local.properties
*.class
Pods/
DerivedData/

# ── Beads / Dolt (kept here up front so `bd init` has little to add; the
#    *.db is scoped to .beads/ so a real project database file is never
#    silently ignored) ──────────────────────────────────────────────────────
.dolt/
.beads/**/*.db
.beads-credential-key
.beads/proxieddb/

# ── Claude Code ephemeral git worktrees ───────────────────────────────────
.claude/worktrees/

# >>> vibe:stack-ignores
# Framework build artefacts — regenerated by `npm run stack:apply`.
node_modules/
dist/
coverage/
.turbo/
*.tsbuildinfo
# <<< vibe:stack-ignores

# `bd init` appends a bare `*.db` here; narrowed to .beads/ so a project's own tracked database is never ignored.
.beads/*.db
