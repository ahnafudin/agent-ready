{
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "node scripts/bd-prime.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/read-guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/install-hooks.mjs"
          },
          {
            "command": "node scripts/bd-prime.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
