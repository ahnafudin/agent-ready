#!/bin/sh
# vibe:hook — owned by scripts/install-hooks.mjs; edit .githooks/, never a copy.
# Strip AI-agent attribution (co-author, session and "Generated with" lines) from every commit message.
# Fail-soft: any problem leaves the message untouched.

MSG="$1"
[ -n "$MSG" ] && [ -f "$MSG" ] || exit 0

TMP="$MSG.vibe-attr"

# One author per commit: EVERY Co-authored-by line goes, so no bot list can fall behind or match a person.
# Credit a human collaborator in the commit body instead.
# The other lines are anchored, so a body that merely discusses attribution is kept.
PATTERN="^[[:space:]]*(Co-authored-by:|(Claude|Cursor|Codex|Copilot)-(Code-)?Session:|(🤖[[:space:]]*)?Generated with[[:space:]]*\[?(Claude Code|Cursor|Copilot|Codex|opencode))"

grep -viE "$PATTERN" "$MSG" > "$TMP" 2>/dev/null || true

# Never write an empty message: if the filter would blank it, keep the original.
if [ ! -s "$TMP" ]; then
  rm -f "$TMP"
  exit 0
fi

# Command substitution drops the trailing newlines the removed trailers left.
printf '%s\n' "$(cat "$TMP")" > "$MSG"
rm -f "$TMP"
exit 0
